# --- Database ---
POSTGRES_USER=eap
POSTGRES_PASSWORD=eap_dev_password
POSTGRES_DB=eap
DATABASE_URL=postgresql+asyncpg://eap:eap_dev_password@postgres:5432/eap

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- LLM Providers (fill in what you use) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# --- MCP Servers ---
MCP_POSTGRES_URL=http://mcp-postgres:9101/sse
MCP_GMAIL_URL=http://mcp-gmail:9102/sse
MCP_DRIVE_URL=http://mcp-drive:9103/sse

# Gmail OAuth (for the Gmail MCP server)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Google Drive OAuth (for the Drive MCP server)
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
